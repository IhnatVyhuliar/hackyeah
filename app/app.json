{
  "expo": {
    "name": "Sellsor",
    "slug": "sellsor",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "pl.unboxproof.sellsor"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Aparat nagrywa pakowanie i otwarcie paczki oraz odczytuje kod z karty.",
          "microphonePermission": "Android wymaga zgody na mikrofon przy nagrywaniu wideo. Nagrania są bez dźwięku.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}
