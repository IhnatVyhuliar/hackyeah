# Gemini (https://aistudio.google.com). Check current model ids before changing GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model answers 429/5xx (overloaded)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
# Optional: minimal | low | medium | high
GEMINI_THINKING_LEVEL=medium
# Optional: leave empty to use the model default
GEMINI_TEMPERATURE=

# Solana (devnet only). Keypair file in solana-keygen JSON format, never commit it.
ORACLE_KEYPAIR=~/.config/unbox/oracle.json
RPC_URL=https://api.devnet.solana.com
# Path to the Anchor IDL synced by `pnpm sync-idl`
IDL_PATH=../packages/shared/idl/unbox_escrow.json
# demo | prod — must match the `demo` feature flag of the deployed program
TIMEOUTS=demo
POLL_INTERVAL_MS=5000

# server/ (evidence in /media, report upload as the oracle account)
API_URL=http://localhost:4000
ORACLE_API_EMAIL=wyrocznia@unbox.local
ORACLE_API_PASSWORD=
