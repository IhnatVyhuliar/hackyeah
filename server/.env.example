# Skopiuj do server/.env (gitignored).
PORT=4000
CHAIN=mock            # mock | devnet
AI=mock               # mock | http
AI_URL=http://localhost:8000
RPC_URL=https://api.devnet.solana.com   # docelowo Helius/QuickNode
PROGRAM_ID=           # z KONTRAKT §5 (puste w trybie mock)
# Tablica JSON z solana-keygen (scripts/keys/*.json)
VERIFIER_SECRET_KEY=
TREASURY_SECRET_KEY=
DEMO_MODE=0           # 1 = orderId z puli plomb (packages/shared/fixtures/seal-pool.json)
JWT_SECRET=change-me
PUBLIC_BASE_URL=http://localhost:4000   # adres tunelu cloudflared na demo
MOCK_AI_DELAY_MS=3000
CRANKER=0             # 1 = co 30 s claim_timeout dla przeterminowanych escrow
