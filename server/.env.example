# Zmienne środowiskowe backendu (Rust). Żadnych prawdziwych sekretów w tym pliku.
# cargo run nie wczytuje plików .env: ustaw zmienne w powłoce albo w menedżerze procesów.
PORT=4000
# mock | http
AI=mock
# serwis wyroczni (Osoba 5), tylko AI=http
AI_URL=http://localhost:8000
AI_TIMEOUT_MS=120000
AI_MAX_ATTEMPTS=3
AI_RETRY_MS=2000
MOCK_AI_DELAY_MS=3000
# limit pliku w POST /api/media
MAX_UPLOAD_MB=60
# demo (minuty) | prod (dni)
TIMEOUTS=demo
# Wymagany przy APP_ENV/NODE_ENV=production (np. openssl rand -hex 32). Bez niego poza produkcją backend
# generuje losowy sekret w DATA_DIR/jwt-secret.
JWT_SECRET=
# adres publiczny backendu (np. tunel na demo); z niego wyrocznia pobiera nagrania
PUBLIC_BASE_URL=http://localhost:4000
# domyślnie server/data
DATA_DIR=
# TEST-ONLY: POST /api/dev/clock. Ignorowane przy APP_ENV/NODE_ENV=production.
ENABLE_DEV_CLOCK=0
