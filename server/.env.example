# Skopiuj do server/.env (gitignored). Żadnych prawdziwych sekretów w tym pliku.
PORT=4000
AI=mock                 # mock | http
AI_URL=http://localhost:8000   # serwis wyroczni (Osoba 5), tylko AI=http
AI_TIMEOUT_MS=120000
AI_MAX_ATTEMPTS=3
MOCK_AI_DELAY_MS=3000
MAX_UPLOAD_MB=60          # limit pliku w POST /api/media
TIMEOUTS=demo           # demo (minuty) | prod (dni)
JWT_SECRET=change-me    # wymagany przy NODE_ENV=production
PUBLIC_BASE_URL=http://localhost:4000   # adres tunelu na demo (z niego AI pobiera nagrania)
# TEST-ONLY: POST /api/dev/clock. Ignorowane przy NODE_ENV=production.
ENABLE_DEV_CLOCK=0
